# Server
PORT=4173
APP_ORIGIN=http://localhost:4173

# Storage mode: mock | s3
STORAGE_DRIVER=mock
PUBLIC_STORAGE_BASE_URL=https://example-r2-public-domain.com
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=face-lora-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# RunPod / worker mode: mock | runpod
WORKER_DRIVER=mock
RUNPOD_API_KEY=
RUNPOD_POD_ID=
RUNPOD_BASE_URL=
RUNPOD_WORKSPACE=/workspace

# ComfyUI mode: mock | comfyui
COMFY_DRIVER=mock
COMFY_BASE_URL=http://127.0.0.1:8188
COMFY_WORKFLOW_PATH=/workspace/ComfyUI/workflows/face_lora_api.json

# Vision caption mode: mock | openai-compatible
CAPTION_DRIVER=mock
VISION_MODEL=
VISION_API_BASE_URL=
VISION_API_KEY=
